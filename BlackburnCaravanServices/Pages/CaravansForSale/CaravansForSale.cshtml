@page
@model CaravansForSaleModel
@using BlackburnCaravanServices.Models

@{
    ViewData["Title"] = "Caravans for Sale";

    var heroModel = new PageHeroModel(
        "Used caravans",
        "Quality used caravans for sale",
        "Browse our latest used caravans or speak to our sales team for friendly advice on finding the right caravan.",
        new[]
        {
            new PageHeroFeatureModel(
                "Checked before sale",
                "Used caravans are inspected before being offered for sale."
            ),
            new PageHeroFeatureModel(
                "Fairly priced stock",
                "Carefully selected caravans with clear, honest information."
            ),
            new PageHeroFeatureModel(
                "Part exchange options",
                "Part exchange may be available depending on your caravan."
            )
        });

    var ctaModel = new CallToActionModel(
        "Looking for a caravan?",
        "Speak to our sales team",
        "We regularly update our stock and can help you find the right caravan for your needs and budget.",
        "Contact sales",
        "/Contact/Contact");
}

<partial name="_PageHero" model="heroModel" />

<section class="section">
    <div class="container">
        <div class="section-heading-split">
            <div>
                <p class="eyebrow">Current stock</p>
                <h2>Caravans currently available</h2>
                <p class="section-intro">
                    Our stock changes regularly. Please call before travelling to check availability.
                </p>
            </div>

            <a href="tel:01254957013" class="button button-primary">
                Call sales
            </a>
        </div>

        @if (Model.Caravans.Count == 0)
        {
            <div class="caravan-empty">
                <h3>No caravans currently advertised</h3>
                <p>
                    Our stock changes regularly. Please contact us to find out
                    what we currently have available.
                </p>

                <a asp-page="/Contact/Contact"
                   class="button button-primary">
                    Contact sales
                </a>
            </div>
        }
        else
        {
            <div class="caravan-grid">
                @foreach (var caravan in Model.Caravans)
                {
                    var primaryImage = caravan.Images
                        .OrderBy(x => x.SortOrder)
                        .FirstOrDefault();

                    <article class="caravan-card">

                        @if (caravan.IsSold)
                        {
                            <span class="caravan-badge">Sold</span>
                        }
                        else
                        {
                            <span class="caravan-badge">Available</span>
                        }

                        @if (primaryImage is not null)
                        {
                            <img src="/CaravanImages/Image/@primaryImage.Id"
                                 alt="@caravan.Make @caravan.Model" />
                        }

                        <div class="caravan-card-content">

                            <p class="caravan-meta">
                                @if (caravan.Year.HasValue)
                                {
                                    <span>@caravan.Year.Value</span>
                                }

                                @if (caravan.Berths.HasValue)
                                {
                                    <span>
                                        · @caravan.Berths.Value berth
                                    </span>
                                }
                            </p>

                            <h3>
                                @caravan.Make @caravan.Model
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(caravan.Description))
                            {
                                <p>
                                    @caravan.Description
                                </p>
                            }

                            <div class="caravan-footer">
                                <strong>
                                    £@caravan.Price.ToString("N0")
                                </strong>

                                <a asp-page="/Contact/Contact">
                                    Enquire
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<partial name="_CallToAction" model="ctaModel" />